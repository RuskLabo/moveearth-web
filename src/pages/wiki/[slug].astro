---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const pages = {
  about: { title: 'MoveEarthについて', label: 'ABOUT MOVEEARTH', text: 'プレイヤー自身の手で文明を発展させ、国を築き、歴史を紡いでいくMinecraftサーバーです。工業化、重砲による攻城戦、独自の領土防衛と経済システムが組み合わさった長期サバイバル環境を提供します。' },
  'voice-chat': { title: 'ModernVoiceChat', label: 'MOVEEARTH ORIGINAL / MODERNVOICECHAT', text: 'MoveEarth全体のコミュニケーションを支える、リアルタイム3Dボイスチャット基盤です。近くにいる人との会話と、無線機を使った遠距離通信を使い分けられます。' },
  streaming: { title: '録画・配信ガイドライン', label: 'RECORDING & STREAMING GUIDELINES', text: 'MoveEarthでは録画・配信を行うことが許可されています。以下のガイドラインを遵守してください。' },
  rules: { title: 'サーバー規約', label: 'SERVER RULES', text: 'MoveEarthで遊ぶ前に確認しておきたいルールやサーバー利用規約をまとめます。' }
};
const rules = [
  { number: 1, title: '禁止される言動', body: '他人を不快にさせる、またはそのおそれのある言動は禁止します。', items: ['ハラスメント、脅迫、わいせつな表現、個人への誹謗中傷、侮辱、差別、名誉毀損。', '暴力的・自傷行為を助長する表現、過度な性的な表現、グロテスクな内容、またはこれらを連想させる用語や内容。'], note: '受け取り手が不快であると判断した場合、運営はその裁量に基づき対処します。' },
  { number: 2, title: '特定の話題に関する制限', body: '宗教、政治、人種に関する議論や、特定の思想・信条を強要する行為は禁止します。', items: ['特定の宗教の布教・批判。', '政治的イデオロギーの主張。', '人種・民族・国籍・性別・性的指向・障がいなどに関する差別的発言。'] },
  { number: 3, title: '宣伝・勧誘の禁止', body: '本サーバーとは無関係のサービス、Discord、イベントなどの宣伝、勧誘、またはそれに準ずる行為は禁止します。', note: 'ただし、サーバー内で公式に認められた連携プロジェクトや国家のDiscordサーバー、または運営が別途許可した場合はこの限りではありません。' },
  { number: 4, title: '他サーバーでの違反経歴', body: '他のサーバーにおいて、荒らし行為や重大な規約違反、またはコミュニティの秩序を著しく乱す行為を行った経歴が確認された場合、本サーバーにおいても利用制限やBANなどの対処を行う場合があります。', note: '運営は、客観的な証拠に基づいて判断を行います。' },
  { number: 5, title: '運営の判断と裁量', body: '本規約に明記されていない行為であっても、本サーバーの健全な運営やコミュニティの安全を阻害すると運営が判断した行為については、対処の対象となる場合があります。', note: '運営の判断は、コミュニティ全体の利益と秩序維持を目的とし、可能な限り客観的な基準に基づき公平に行われます。' },
  { number: 6, title: '問題対処の時間と協力', body: 'サーバー内の問題への対応には時間を要する場合があります。対応が遅れる場合でも、ご理解とご協力をお願いいたします。', note: '運営に対する執拗な催促、不当な要求、または業務を妨害する行為は禁止し、場合によっては対処の対象となることがあります。' },
  { number: 7, title: '運営のなりすまし・志願の禁止', body: '運営になりすます行為、または運営の指示を偽って発信する行為は禁止します。', note: '運営への不必要な連絡や、運営チームへの参加を過度に要求する行為もご遠慮ください。' },
  { number: 8, title: '外部規約の遵守', body: 'DiscordおよびMinecraftの公式規約を遵守してください。', note: 'これらの規約に違反する行為は、本サーバーの規約違反とみなされ、対処の対象となります。' },
  { number: 9, title: '個人間の問題解決', body: '利用者間の軽微な意見の相違や言い争いは、当事者同士での解決を原則とします。', note: 'ハラスメント、脅迫、ストーカー行為など、当事者間での解決が困難な問題、または重大な規約違反に該当すると思われる場合は、速やかに運営にご報告ください。運営は状況に応じて介入し、適切な対処を行います。' },
  { number: 10, title: '国家・組織の名称に関する制限（世界観の維持）', body: '本サーバー内で設立される国家、都市、企業、宗教、その他あらゆる組織の名称において、現実の歴史上または現在実在する国家・組織の名称（例：「日本」「大英帝国」「アメリカ合衆国」など）を使用することを禁止します。', note: 'ただし、「現実の特定の文化や建築様式をモチーフにする（例：和風建築、中世ヨーロッパ風など）」ことや、「モチーフに沿った架空の名称（例：扶桑、大和、アルビオンなど）」を使用することは問題ありません。本サーバーの独自の世界観と歴史を創造するための配慮をお願いいたします。' },
  { number: 11, title: '高負荷施設・回路の構築禁止（サーバー負荷対策）', body: 'サーバー全体のパフォーマンスを著しく低下させる、または常時高い負荷を与え続ける施設・機械・回路の構築を禁止します。', items: ['常時稼働（開放時間ずっと動かし続ける状態）する、大規模なCreateの自動生産ラインやクロック回路。', '稼働時に著しいラグ（TPSの低下、チャンクの読み込み遅延）を引き起こす、過剰な規模の工業プラントやエンティティを大量に消費する施設。'], note: '運営から負荷軽減のための設計変更、または施設の稼働停止を要請された場合、プレイヤーは速やかにこれに従わなければなりません。改善が見られない場合、運営の裁量により施設を強制撤去・解体する場合があります。' },
  { number: 12, title: '不適切なスキンの禁止', body: '他のプレイヤーが不快に感じる、または透明化するなどの不正なスキンは禁止します。' },
  { number: 13, title: 'バグ・グリッチ・Dupeの報告義務と禁止', body: 'サーバーのバグ、グリッチ、またはアイテム増殖（Duplication）を意図的に探す行為、およびこれらを利用して不正に利益を得る行為は禁止します。', note: '発見した場合は、利用せずに速やかに運営にご報告ください。悪用した場合、または報告を怠りながら利用していたことが発覚した場合は、規約に準じた厳正な処罰（BANを含む）の対象となります。' },
  { number: 14, title: 'ハック・チート・不正行為の禁止', body: 'ハッククライアント、不正なテクスチャパック、チートツール、その他不正行為（バグの悪用を含む）の使用は禁止します。' },
  { number: 15, title: 'サブアカウントの利用禁止', body: '一人につき一つのアカウントでのプレイを原則とし、サブアカウントの利用は禁止します。' },
  { number: 16, title: '特定のテクスチャ・ツールの禁止', body: 'X-rayやESPなど、ゲームバランスを著しく損なうテクスチャパックやツールの使用は禁止します。', note: 'ただし、暗視効果を持つテクスチャなど、ゲームプレイを補助する目的のものは許可される場合があります。' },
  { number: 17, title: '音声通信の記録および配信に関する同意', body: '本サーバー内における近接ボイスチャットおよび無線通信（以下「音声通信」）は、他のプレイヤーによって動画撮影、ライブ配信、または音声ログとして記録される場合があります。', note: 'プレイヤーは本サーバーに参加した時点で、自身の音声通信が第三者のコンテンツ内に含まれ、公開される可能性があることに同意したものとみなします。音声通信を利用する際は、個人情報の取り扱いや発言内容に十分注意し、自己責任において利用してください。' }
];
type PageKey = keyof typeof pages;
export function getStaticPaths() {
  return ['about', 'voice-chat', 'streaming', 'rules'].map((slug) => ({ params: { slug } }));
}
const slug = (Astro.params.slug ?? 'about') as PageKey;
const page = pages[slug] ?? pages.about;
---
<BaseLayout title={page.title}><article class="mx-auto max-w-3xl px-5 py-20 md:px-10"><a href={`${base}/wiki/`} class="text-sm text-primary">← Wikiに戻る</a><p class="mono mt-12 text-sm text-secondary">{page.label}</p><h1 class="mt-3 text-4xl font-black">{page.title}</h1><div class="divider"></div><p class="text-lg leading-9 text-base-content/80">{page.text}</p>{slug === 'voice-chat' && <div class="mt-10 grid gap-4 md:grid-cols-2"><div class="card border border-white/10 bg-base-200 p-5"><h2 class="text-xl font-bold">3D近接ボイス</h2><p class="mt-2 text-sm leading-7 text-base-content/70">プレイヤー同士の距離に応じて聞こえ方が変わります。街中での会話や、探索中の自然なコミュニケーションに利用できます。</p></div><div class="card border border-white/10 bg-base-200 p-5"><h2 class="text-xl font-bold">無線機</h2><p class="mt-2 text-sm leading-7 text-base-content/70">無線機を使うと、周波数を合わせたプレイヤー同士で遠距離通信ができます。通信距離に応じたノイズも特徴です。</p></div><div class="card border border-white/10 bg-base-200 p-5"><h2 class="text-xl font-bold">基本操作</h2><p class="mt-2 text-sm leading-7 text-base-content/70">無線機を右クリック長押しで送信、左クリックで周波数設定画面を開きます。</p></div><div class="card border border-white/10 bg-base-200 p-5"><h2 class="text-xl font-bold">対応環境</h2><p class="mt-2 text-sm leading-7 text-base-content/70">Minecraft 1.21.1、NeoForge環境を前提としています。詳細な導入方法はModpackの案内を確認してください。</p></div></div>}{slug === 'streaming' && <div class="mt-10 grid gap-4"><div class="card border border-primary/30 bg-primary/10 p-6"><h2 class="text-2xl font-bold">録画・配信は許可されています</h2><p class="mt-3 leading-8 text-base-content/80">MoveEarthでは、YouTubeやTwitchなどのプラットフォームにおける動画撮影およびライブ配信が全面的に許可されています。</p></div><div class="card border border-white/10 bg-base-200 p-6"><p class="mono text-sm text-secondary">REQUIRED</p><h2 class="mt-2 text-xl font-bold">配信時は /live でprefixを付ける</h2><p class="mt-3 leading-8 text-base-content/80">配信を行う際は、ゲーム内チャットで <code class="rounded bg-base-300 px-2 py-1 text-primary">/live</code> コマンドを実行してください。ネームタグ等に配信中であることを示すプレフィックスが付与されます。配信終了時は再度 <code class="rounded bg-base-300 px-2 py-1 text-primary">/live</code> を実行することで解除できます。</p></div><div class="card border border-white/10 bg-base-200 p-6"><p class="mono text-sm text-secondary">PRIVACY & RULES</p><h2 class="mt-2 text-xl font-bold">他プレイヤーへの配慮と音声通信</h2><p class="mt-3 leading-8 text-base-content/80">サーバー規約第17条に基づき、近接ボイスチャットおよび無線通信は配信や動画に含まれる場合があります。配信者自身も個人情報の管理に注意し、健全な配信活動をお願いいたします。</p></div></div>}{slug === 'about' && <div class="mt-10 space-y-6"><div class="grid gap-4 md:grid-cols-2"><div class="card border border-white/10 bg-base-200 p-5"><h2 class="text-xl font-bold">基本環境</h2><ul class="mt-3 list-inside list-disc space-y-2 text-sm leading-7 text-base-content/75"><li>バージョン: Minecraft 1.21.1 (NeoForge)</li><li>開放時間: 毎日 JST 19:00〜23:00 (1日4時間)</li><li>参加方法: <a href={`${base}/join/`} class="text-primary underline">参加案内ページ</a> を参照</li></ul></div><div class="card border border-white/10 bg-base-200 p-5"><h2 class="text-xl font-bold">主要システム・MOD</h2><ul class="mt-3 list-inside list-disc space-y-2 text-sm leading-7 text-base-content/75"><li>国家・領土・戦争: MoveEarth-Addtional (独自)</li><li>兵器・工業: Create, Create Big Cannons, Warnautics</li><li>移動体・銃器: Sable, Aeronautics, TaCZ</li><li>経済・VC: Lightman's Currency, ModernVoiceChat</li></ul></div></div><div class="alert border border-primary/20 bg-primary/10"><span>文明、国家、交易、技術。プレイヤーの選択がこの世界の歴史になります。</span></div></div>}{slug === 'rules' && <div class="mt-10 space-y-5">{rules.map((rule) => <section class="rounded-box border border-white/10 bg-base-200 p-5"><h2 class="text-lg font-bold"><span class="mono mr-2 text-sm text-secondary">第{rule.number}条</span>{rule.title}</h2><p class="mt-3 leading-8 text-base-content/80">{rule.body}</p>{rule.items && <ul class="mt-3 list-disc space-y-2 pl-5 leading-7 text-base-content/75">{rule.items.map((item) => <li>{item}</li>)}</ul>}{rule.note && <p class="mt-3 border-l-2 border-primary/50 pl-4 text-sm leading-7 text-base-content/65">{rule.note}</p>}</section>)}</div>}</article></BaseLayout>
