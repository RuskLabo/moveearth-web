---
import LegacyRedirect from '../../components/LegacyRedirect.astro';

export function getStaticPaths() {
  const destinations: Record<string, string> = {
    about: 'guide/about',
    'voice-chat': 'guide/communication',
    streaming: 'guide/streaming',
    rules: 'guide/rules',
    jobs: 'guide/jobs',
    'starter-kit': 'guide/starter-kit',
    'player-detector': 'guide/player-detector',
    'gun-disassembly': 'guide/gun-disassembly',
    'airship-raid': 'guide/airship-raid',
    tpa: 'guide/survival#地図と移動',
  };
  return Object.entries(destinations).map(([slug, target]) => ({
    params: { slug }, props: { target },
  }));
}

const { target } = Astro.props;
---
<LegacyRedirect target={target} />
