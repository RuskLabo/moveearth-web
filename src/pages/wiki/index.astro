---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const categories = [
  ['MoveEarthについて', 'この世界の目的と遊び方を知る', '世界観・初心者ガイド'],
  ['ModernVoiceChat', 'MoveEarthの音声コミュニケーション基盤', '近接VC・無線機・周波数'],
  ['プレイヤー検知ブロック', 'MoveEarth-Addtionalの独自ブロック', '所有者・ホワイトリスト・決済'],
  ['録画・配信ガイドライン', 'MoveEarthで録画・配信を行う際の案内', '配信時のprefixについて'],
  ['サーバー仕様', '参加前に確認したいルールと仕様', 'ルール・ワールド・FAQ']
];
---
<BaseLayout title="Wiki"><section class="mx-auto max-w-6xl px-5 py-20 md:px-10"><p class="mono text-sm text-primary">MOVEEARTH KNOWLEDGE BASE</p><h1 class="mt-3 text-4xl font-black md:text-5xl">MoveEarth Wiki</h1><p class="mt-5 max-w-2xl leading-8 text-base-content/70">MoveEarth独自のシステムや、サーバーでの遊び方をまとめています。MODそのものの詳しい仕様ではなく、MoveEarthでの使われ方を中心に解説します。</p><div class="mt-12 grid gap-4 md:grid-cols-2">{categories.map(([title, description, topics], index) => <a href={`${base}/wiki/${['about', 'voice-chat', 'player-detector', 'streaming', 'rules'][index]}/`} class="card border border-white/10 bg-base-200 p-6 transition hover:-translate-y-1 hover:border-primary/50"><p class="mono text-xs text-secondary">CATEGORY {String(index + 1).padStart(2, '0')}</p><h2 class="mt-3 text-2xl font-bold">{title}</h2><p class="mt-2 text-base-content/70">{description}</p><p class="mt-5 text-sm text-primary">{topics} →</p></a>)}</div></section></BaseLayout>
