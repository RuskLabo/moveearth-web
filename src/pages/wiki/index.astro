---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const categories = [
  ['MoveEarthについて', 'この世界の目的と遊び方を知る', '世界観・初心者ガイド', 'about'],
  ['ModernVoiceChat', 'MoveEarthの音声コミュニケーション基盤', '近接VC・無線機・周波数', 'voice-chat'],
  ['プレイヤー検知ブロック', 'MoveEarth-Addtionalの独自ブロック', '所有者・ホワイトリスト・決済', 'player-detector'],
  ['初期装備', '新しく参加したプレイヤー向けの初心者キット', '支給内容・受取条件・コマンド', 'starter-kit'],
  ['飛行船襲撃', 'Sableで出現する敵対飛行船イベント', '難易度・戦闘・撃墜・サルベージ', 'airship-raid'],
  ['録画・配信ガイドライン', 'MoveEarthで録画・配信を行う際の案内', '配信時のprefixについて', 'streaming'],
  ['サーバー規約', '参加前に確認したいルールと規約', '禁止事項・運営方針・音声通信', 'rules']
];
---
<BaseLayout title="Wiki">
  <section class="mx-auto max-w-6xl px-5 py-20 md:px-10">
    <p class="mono text-sm text-primary">MOVEEARTH KNOWLEDGE BASE</p>
    <h1 class="mt-3 text-4xl font-black md:text-5xl">MoveEarth Wiki</h1>
    <p class="mt-5 max-w-2xl leading-8 text-base-content/70">MoveEarth独自のシステムや、サーバーでの遊び方をまとめています。MODそのものの詳しい仕様ではなく、MoveEarthでの使われ方を中心に解説します。</p>
    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {categories.map(([title, description, topics, slug], index) => <a href={`${base}/wiki/${slug}/`} class="card border border-white/10 bg-base-200 p-6 transition hover:-translate-y-1 hover:border-primary/50"><p class="mono text-xs text-secondary">CATEGORY {String(index + 1).padStart(2, '0')}</p><h2 class="mt-3 text-2xl font-bold">{title}</h2><p class="mt-2 text-base-content/70">{description}</p><p class="mt-5 text-sm text-primary">{topics} →</p></a>)}
    </div>
  </section>
</BaseLayout>
